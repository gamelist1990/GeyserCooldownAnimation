{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.geyser_cooldown.first_person": {
      "geometry": "Geometry.first_person",
      "materials": [
        {
          "*": "variable.is_enchanted ? material.enchanted : material.default"
        }
      ],
      "textures": [
        "texture.default",
        "texture.enchanted"
      ]
    },
    "controller.render.geyser_cooldown.third_person": {
      "textures": [
        "texture.default",
        "texture.enchanted"
      ],
      "materials": [
        {
          "*": "variable.is_enchanted ? material.enchanted : material.default"
        }
      ],
      "geometry": "Geometry.third_person"
    },
    "controller.render.geyser_cooldown.mace": {
      "geometry": "geometry.default",
      "materials": [
        {
          "*": "variable.is_enchanted ? material.enchanted : material.default"
        }
      ],
      "textures": [
        "texture.default",
        "texture.enchanted"
      ]
    }
  }
}
